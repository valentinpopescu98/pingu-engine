# General
/*
!.gitignore
!/CMakeLists.txt
!/vcpkg.json
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/workflows/*.yaml
!/README.md
!icon.ico
!imgui.ini
!LICENSE.md

# Application
!/deps
!/docs
!/resources
!/src
!/vs

# Visual Studio
/vs/*
!/vs/*.aps
!/vs/*.rc
!/vs/*.sln
!/vs/*.vcxproj
!/vs/*.vcxproj.filters
!/vs/*.vcxproj.user
!/vs/resource.h

# CMake outputs (root-level build directory is intentionally not tracked)
/build/**
